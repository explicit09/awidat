{
  "cases": [
    {
      "name": "before first keyframe holds first value",
      "keyframes": [
        { "time_s": 1.0, "value": 2.0, "interpolation": "linear", "easing": "linear" },
        { "time_s": 2.0, "value": 4.0, "interpolation": "linear", "easing": "linear" }
      ],
      "samples": [
        { "time_s": 0.0, "expected": 2.0 },
        { "time_s": 1.0, "expected": 2.0 }
      ]
    },
    {
      "name": "after last keyframe holds last value",
      "keyframes": [
        { "time_s": 0.0, "value": 2.0, "interpolation": "linear", "easing": "linear" },
        { "time_s": 1.0, "value": 4.0, "interpolation": "linear", "easing": "linear" }
      ],
      "samples": [
        { "time_s": 1.0, "expected": 4.0 },
        { "time_s": 2.0, "expected": 4.0 }
      ]
    },
    {
      "name": "hold interpolation keeps previous value",
      "keyframes": [
        { "time_s": 0.0, "value": 2.0, "interpolation": "hold", "easing": "linear" },
        { "time_s": 1.0, "value": 4.0, "interpolation": "linear", "easing": "linear" }
      ],
