{
  "id": "acceptance::real_video_generated_edl_behavior_name",
  "objective": "Describe the user-visible editing behavior being generated and tested.",
  "project": {
    "name": "acceptance-real-video-generated-edl-behavior-name",
    "source_asset": "raw/source.mp4",
    "source_path": "/ABSOLUTE/PATH/TO/LOCAL/SOURCE.mp4",
    "source_start_s": 0.0,
    "source_duration_s": 30.0
  },
  "edl_generator": {
    "command": [
      "/bin/sh",
      "-c",
      "exec \"${AWIDAT_ACCEPTANCE_CLI:-/ABSOLUTE/PATH/TO/awidat}\" plan-dead-air-edl \"$AWIDAT_ACCEPTANCE_PROJECT_ROOT\" --min-duration-s 0.8 --silence-threshold-db -40.0"
    ]
  },
  "expect": {
    "duration_min_s": 20.0,
    "duration_max_s": 30.5,
    "max_long_silence_s": 0.8,
    "silence_threshold_db": -40.0,
    "max_black_segment_s": 0.2,
    "black_min_duration_s": 0.2,
    "min_clip_count": 1,
    "edl_must_contain": [
      "*** Trim Clip",
      "*** Insert Clip"
    ],
    "removed_source_ranges": [
      {
        "start_s": 1.2,
        "end_s": 2.5,
        "reason": "dead air, filler, false start, or other unwanted material",
        "tolerance_s": 0.15
      }
    ],
    "kept_source_ranges": [
      {
        "start_s": 3.0,
        "end_s": 8.0,
        "reason": "important spoken content or visual moment",
        "tolerance_s": 0.15
      }
    ]
  }
}
